# Copy to .env and change these before running anywhere other than your own machine.

MYSQL_DATABASE=ums
MYSQL_USER=ums
MYSQL_PASSWORD=change_this_db_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# Signs the login tokens. Must be at least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRATION_MS=28800000

# The first administrator, created on first start if no such user exists
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password

# true creates sample departments, teachers, students and courses on first start; false starts empty
SEED_DEMO_DATA=true

# Public sign-up page for students and teachers
# SIGNUP_ENABLED=false hides the page and refuses sign-ups.
# SIGNUP_REQUIRE_APPROVAL=true creates accounts as disabled until an administrator switches them on.
SIGNUP_ENABLED=true
SIGNUP_REQUIRE_APPROVAL=false

# Host ports. Change these if 8080 or 3000 is already taken on your computer.
BACKEND_PORT=8080
FRONTEND_PORT=3000
